# Copy this file to ".env" and fill in real values (never commit .env).

PORT=5000

# Local MongoDB: mongodb://127.0.0.1:27017/password_manager
# Or MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster0.example.mongodb.net/password_manager
MONGO_URI=mongodb://127.0.0.1:27017/password_manager

# Use a long, random, unguessable string (e.g. output of: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Master key used for AES-256-GCM encryption of stored passwords.
# A SHA-256 digest of this value is used as the actual cipher key, so any length works.
ENCRYPTION_KEY=replace_with_a_long_random_secret_key

# Origins allowed to call the API (comma separated).
CLIENT_ORIGIN=http://localhost:5173
